<Window x:Class="SDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SDM.App.ViewModels"
        xmlns:conv="clr-namespace:SDM.App.Converters"
        mc:Ignorable="d"
        Title="SDM 다운로드 관리자"
        Height="760" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/sdm.ico">
    <Window.Resources>
        <conv:StatusBrushConverter x:Key="StatusBrush"/>
        <conv:InverseBoolToVis x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,20,18,18"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,11,0">
                            <Viewbox Margin="9">
                                <Path Fill="#041B15" Data="M10 4v8.17l-2.59-2.58L6 11l6 6 6-6-1.41-1.41L14 12.17V4h-4zm-6 14v2h16v-2H4z"/>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SDM" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="DOWNLOAD DESK" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="13" CornerRadius="10"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="브라우저 상태" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BrowserLine}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Button Content="브라우저 연결 설정" Style="{StaticResource GhostButton}" Command="{Binding BrowserCommand}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Category" Style="{StaticResource SidebarButton}"
                                             Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding Id}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <Border Grid.Column="1" MinWidth="26" Padding="7,2" CornerRadius="9" Background="#20324A">
                                            <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="11"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Padding="22,18" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="다운로드" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding ResultLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="검색  ·  Ctrl+F" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="파일명 또는 URL 검색"/>
                            <Button Content="지우기" Style="{StaticResource GhostButton}" Padding="10,4" MinHeight="30"
                                    HorizontalAlignment="Right" Margin="0,5,5,5"
                                    Command="{Binding ClearSearchCommand}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="18,12" Background="#0D1728"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <WrapPanel>
                    <Button Content="+ 다운로드 추가" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                    <Button Content="재개" Style="{StaticResource GhostButton}" Command="{Binding ResumeCommand}" Margin="0,0,8,0"/>
                    <Button Content="일시정지" Style="{StaticResource GhostButton}" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
                    <Button Content="정지" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Content="목록에서 삭제" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" Margin="0,0,8,0"/>
                    <Button Content="저장 위치" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="미디어 스니퍼" Style="{StaticResource GhostButton}" Command="{Binding SnifferCommand}" Margin="0,0,8,0"/>
                    <Button Content="설정" Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}"/>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="2" Background="{StaticResource BgBrush}">
                <ListBox x:Name="JobList"
                         ItemsSource="{Binding VisibleItems}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         Foreground="{StaticResource TextBrush}"
                         BorderThickness="0"
                         Padding="8"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Card" Property="Background" Value="#14283A"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#49617E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="12,0,0,12"
                                        Background="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                <Grid Grid.Column="1" Margin="18,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Padding="9,3" CornerRadius="9" Background="#203149">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Url}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,5,0,10" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Grid.Row="2" Value="{Binding Progress}" Maximum="100" Margin="0,0,0,9"/>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBoolToVis}}"
                            IsHitTestVisible="False">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource SurfaceAltBrush}">
                        <TextBlock Text="↓" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                    </Border>
                    <TextBlock Text="다운로드가 없습니다" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,5"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="새 주소를 추가하거나 검색 조건을 변경하세요." Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusLine}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <Canvas x:Name="SpeedCanvas" Grid.Column="1" Height="24" Margin="10,0"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding SpeedLine}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentSoftBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

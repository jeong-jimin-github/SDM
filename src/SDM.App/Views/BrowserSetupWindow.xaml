<Window x:Class="SDM.App.Views.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="브라우저 연결 — SDM"
        Height="700" Width="820"
        MinHeight="650" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/sdm.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="브라우저 연결" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Chrome 계열과 Firefox에서 SDM으로 다운로드 요청을 보냅니다."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#12263A" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="연결 구성 상태" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,18,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="연결 파일 준비" Style="{StaticResource AccentButton}"
                        Width="142" Click="Install_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="12" Background="#1B3654" HorizontalAlignment="Left">
                        <TextBlock Text="C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chrome · Edge · Brave" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
                    <TextBlock Text="1. 연결 파일 준비를 누릅니다.&#x0a;2. 확장 관리 페이지에서 개발자 모드를 켭니다.&#x0a;3. ‘압축해제된 확장 프로그램 로드’를 선택합니다.&#x0a;4. 아래 버튼으로 연 폴더를 지정합니다."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                    <Button Content="확장 관리 페이지 열기" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,8" Click="OpenChromeExtPage_Click"/>
                    <Button Content="Chrome 확장 폴더 열기" Style="{StaticResource GhostButton}"
                            Click="OpenChrome_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="12" Background="#3C274E" HorizontalAlignment="Left">
                        <TextBlock Text="F" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Firefox" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
                    <TextBlock Text="1. Firefox 디버깅 페이지를 엽니다.&#x0a;2. ‘임시 부가 기능 로드’를 누릅니다.&#x0a;3. 아래 버튼으로 연 폴더의 manifest.json을 선택합니다.&#x0a;4. 브라우저를 재시작하면 임시 확장을 다시 로드합니다."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                    <Button Content="Firefox 디버깅 열기" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,8" Click="OpenFirefoxDebug_Click"/>
                    <Button Content="Firefox 확장 폴더 열기" Style="{StaticResource GhostButton}"
                            Click="OpenFirefox_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathHint" Foreground="{StaticResource SubtleBrush}" FontSize="10"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="닫기" Style="{StaticResource GhostButton}"
                    Width="90" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

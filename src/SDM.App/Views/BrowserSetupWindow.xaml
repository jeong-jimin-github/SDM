<Window x:Class="SDM.App.Views.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="브라우저 연결 — SDM"
        Height="740" Width="820"
        MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/sdm.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="브라우저 연결" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Chrome 계열과 Firefox에서 SDM으로 다운로드 요청을 보냅니다."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#12263A" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="연결 구성 상태" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,18,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="연결 파일 준비" Style="{StaticResource AccentButton}"
                        Width="142" Click="Install_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1B3654" HorizontalAlignment="Left">
                            <TextBlock Text="C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <TextBlock Text="Chrome · Edge · Brave" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
                        <TextBlock Text="1. 연결 파일 준비를 누릅니다.&#x0a;2. 확장 관리 페이지에서 개발자 모드를 켭니다.&#x0a;3. 아래 카드를 확장 페이지로 끌어다 놓습니다."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        <Button Content="확장 관리 페이지 열기" Style="{StaticResource AccentButton}"
                                Margin="0,18,0,10" Click="OpenChromeExtPage_Click"/>
                    </StackPanel>
                    <Border x:Name="ChromeDragCard"
                            Cursor="Hand"
                            Background="#16324F"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="14,12"
                            VerticalAlignment="Top"
                            PreviewMouseLeftButtonDown="ChromeDragCard_OnPreviewMouseLeftButtonDown"
                            MouseMove="ChromeDragCard_OnMouseMove"
                            ToolTip="마우스 왼쪽 버튼으로 잡은 뒤 Chrome 확장 페이지에 놓으세요">
                        <StackPanel>
                            <TextBlock Text="이 카드를 확장 페이지로 드래그"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="파일 관리자를 열지 않습니다. 개발자 모드를 켠 페이지 위에 놓으면 확장이 로드됩니다."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="ChromeDragPath" FontSize="10"
                                       Foreground="{StaticResource SubtleBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#3C274E" HorizontalAlignment="Left">
                            <TextBlock Text="F" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <TextBlock Text="Firefox" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
                        <TextBlock Text="1. Firefox 디버깅 페이지를 엽니다.&#x0a;2. ‘임시 부가 기능 로드’를 누릅니다.&#x0a;3. 아래 카드를 파일 선택 창으로 끌어다 놓거나 manifest.json을 고릅니다."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        <Button Content="Firefox 디버깅 열기" Style="{StaticResource AccentButton}"
                                Margin="0,18,0,10" Click="OpenFirefoxDebug_Click"/>
                    </StackPanel>
                    <Border x:Name="FirefoxDragCard"
                            Cursor="Hand"
                            Background="#2A1B38"
                            BorderBrush="#7A5EA0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="14,12"
                            VerticalAlignment="Top"
                            PreviewMouseLeftButtonDown="FirefoxDragCard_OnPreviewMouseLeftButtonDown"
                            MouseMove="FirefoxDragCard_OnMouseMove"
                            ToolTip="마우스 왼쪽 버튼으로 잡은 뒤 Firefox 파일 선택 창에 놓으세요">
                        <StackPanel>
                            <TextBlock Text="이 카드를 파일 선택 창으로 드래그"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="파일 관리자를 열지 않습니다. 임시 부가 기능 로드 창에 놓으세요."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="FirefoxDragPath" FontSize="10"
                                       Foreground="{StaticResource SubtleBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathHint" Foreground="{StaticResource SubtleBrush}" FontSize="10"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="닫기" Style="{StaticResource GhostButton}"
                    Width="90" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="SDM.App.Views.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="브라우저 연결 — SDM"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        ResizeMode="NoResize"
        Icon="/Assets/sdm.ico">
    <DockPanel Margin="22">
        <TextBlock DockPanel.Dock="Top" Text="브라우저 자동 연결" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"
                   Text="Chrome / Edge / Brave / Firefox 확장과 Native Messaging을 등록합니다. 스토어 심사가 필요 없는 로컬 확장으로 동작합니다."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="닫기" Style="{StaticResource GhostButton}" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <ScrollViewer>
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13"/>
                        <Button Content="연결 및 설치 시작" Style="{StaticResource AccentButton}" Width="170" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="Install_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Chrome / Edge / Brave" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"
                           Text="위의 ‘연결 및 설치 시작’을 누르면 확장 폴더와 설치 페이지가 함께 열리고 경로도 복사됩니다. 개발자 모드를 켠 뒤 ‘압축해제된 확장 프로그램을 로드합니다’를 눌러 열린 폴더를 선택하세요."/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Chrome 확장 폴더" Style="{StaticResource GhostButton}" Click="OpenChrome_Click" Margin="0,0,8,0"/>
                    <Button Content="확장 페이지 열기" Style="{StaticResource GhostButton}" Click="OpenChromeExtPage_Click"/>
                </StackPanel>

                <TextBlock Text="Firefox" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"
                           Text="1. about:debugging#/runtime/this-firefox 를 엽니다.&#x0a;2. '임시 부가 기능 로드'에서 Firefox 확장 폴더의 manifest.json을 선택합니다.&#x0a;3. 영구 설치는 Firefox Developer Edition 또는 about:config 의 xpinstall.signatures.required=false 가 필요합니다."/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Firefox 확장 폴더" Style="{StaticResource GhostButton}" Click="OpenFirefox_Click" Margin="0,0,8,0"/>
                    <Button Content="about:debugging" Style="{StaticResource GhostButton}" Click="OpenFirefoxDebug_Click"/>
                </StackPanel>

                <TextBlock x:Name="PathHint" Margin="0,18,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="SDM.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 — SDM"
        Height="690" Width="660"
        MinHeight="650" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/sdm.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="설정" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="다운로드 동작과 Windows 통합 옵션을 관리합니다."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="저장 및 성능" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                    <TextBlock Text="기본 저장 폴더" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox"/>
                        <Button Grid.Column="2" Content="찾아보기" Style="{StaticResource GhostButton}" Click="Browse_Click"/>
                    </Grid>
                    <CheckBox x:Name="CategoryFoldersBox" Content="파일 종류별 하위 폴더를 자동으로 사용" Margin="0,10,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="기본 연결 수 (1–32)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ConnBox" TextAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="동시 다운로드 (1–16)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ConcurrentBox" TextAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="속도 제한 (KB/s)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LimitBox" TextAlignment="Right" ToolTip="0이면 속도를 제한하지 않습니다."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="캡처 및 복구" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ClipboardBox" Content="클립보드의 다운로드 주소 감지"/>
                        <CheckBox x:Name="ConfirmBox" Content="브라우저 요청 전에 확인 창 표시"/>
                        <CheckBox x:Name="ResumeBox" Content="시작할 때 미완료 작업 자동 재개"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Windows 동작" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="TrayBox" Content="닫기 버튼을 누르면 트레이로 이동"/>
                        <CheckBox x:Name="StartupBox" Content="Windows 로그인 시 SDM 실행"/>
                        <CheckBox x:Name="NotifyBox" Content="완료 및 실패 알림 표시"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="숫자 입력은 저장할 때 허용 범위로 자동 보정됩니다."
                       Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="취소" Style="{StaticResource GhostButton}" Width="90"
                        IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="설정 저장" Style="{StaticResource AccentButton}" Width="104"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

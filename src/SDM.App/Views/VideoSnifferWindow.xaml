<Window x:Class="SDM.App.Views.VideoSnifferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="미디어 스니퍼 — SDM"
        Height="600" Width="920"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/sdm.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="미디어 스니퍼" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="브라우저에서 감지한 오디오와 비디오 요청"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="목록 비우기" Style="{StaticResource DangerButton}"
                    Click="Clear_Click" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12,9" CornerRadius="8"
                Background="#12263A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="항목을 더블클릭하면 다운로드 추가 창이 열립니다. 파일 주소, 형식, 원본 페이지를 확인하세요."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <ListView Grid.Row="2" x:Name="List"
                  MouseDoubleClick="List_MouseDoubleClick"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="파일 주소" Width="390">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UrlShort}" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Hit.Url}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="형식" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#203149" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Mime}" Foreground="{StaticResource AccentSoftBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="원본 페이지" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="더블클릭: 다운로드 추가  ·  열 머리글 드래그: 순서 변경"
                   Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="2,12,0,0"/>
    </Grid>
</Window>

<Window x:Class="SDM.App.Views.VideoSnifferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비디오 스니퍼 — SDM"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/sdm.ico">
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="감지된 미디어" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="비우기" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                   Text="브라우저 확장이 페이지의 video/audio 요청을 포착합니다. 항목을 더블클릭하면 다운로드합니다."/>
        <ListView x:Name="List" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                  MouseDoubleClick="List_MouseDoubleClick" Foreground="{StaticResource TextBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="파일" Width="240" DisplayMemberBinding="{Binding UrlShort}"/>
                    <GridViewColumn Header="형식" Width="120" DisplayMemberBinding="{Binding Mime}"/>
                    <GridViewColumn Header="페이지" Width="280" DisplayMemberBinding="{Binding PageTitle}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>

<Window x:Class="SDM.App.Views.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다운로드 추가 — SDM"
        Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/sdm.ico"
        TextElement.Foreground="#F8FAFC">
    <DockPanel Margin="22">
        <TextBlock DockPanel.Dock="Top" Text="새 다운로드" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SummaryName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F8FAFC" Text="파일 정보를 읽는 중…"/>
                <TextBlock x:Name="SummaryMeta" Margin="0,6,0,0" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Style="{StaticResource GhostButton}" Width="88" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="대기열에 넣기" Style="{StaticResource GhostButton}" Width="120" Click="Queue_Click" Margin="0,0,8,0"/>
            <Button x:Name="StartButton" Content="바로 시작" Style="{StaticResource AccentButton}" Width="108" Click="Start_Click" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="주소" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UrlBox" Height="34" Foreground="#F8FAFC" Background="#0B1224" CaretBrush="#34D399"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="파일 이름" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Height="34" Foreground="#F8FAFC" Background="#0B1224" CaretBrush="#34D399"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="연결 수" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <TextBlock x:Name="ConnLabel" DockPanel.Dock="Right" Width="28" Text="8" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <Slider x:Name="ConnSlider" Minimum="1" Maximum="32" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ConnSlider_OnValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="저장 폴더" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="찾기" Style="{StaticResource GhostButton}" Width="72" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="FolderBox" Height="34" Foreground="#F8FAFC" Background="#0B1224" CaretBrush="#34D399"/>
                </DockPanel>
                <TextBlock x:Name="CategoryHint" Margin="0,12,0,0" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\sdm.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SDM</AssemblyName>
    <RootNamespace>SDM.App</RootNamespace>
    <Product>SDM</Product>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationTitle>SDM</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Drawing2D" />
    <Using Remove="System.Drawing.Imaging" />
    <Using Remove="System.Drawing.Text" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDM.Core\SDM.Core.csproj" />
    <ProjectReference Include="..\SDM.NativeHost\SDM.NativeHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\sdm.ico" />
    <Content Include="Assets\sdm.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\extensions\chrome\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>extensions\chrome\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\extensions\firefox\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>extensions\firefox\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeHost" AfterTargets="Build;Publish">
    <PropertyGroup>
      <NativeHostOut>..\SDM.NativeHost\bin\$(Configuration)\net10.0-windows\</NativeHostOut>
    </PropertyGroup>
    <ItemGroup>
      <_NativeHostCopy Include="$(NativeHostOut)SDM.NativeHost.exe" />
      <_NativeHostCopy Include="$(NativeHostOut)SDM.NativeHost.dll" />
      <_NativeHostCopy Include="$(NativeHostOut)SDM.NativeHost.deps.json" />
      <_NativeHostCopy Include="$(NativeHostOut)SDM.NativeHost.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeHostCopy)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>
</Project>

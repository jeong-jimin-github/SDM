<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#08101F</Color>
    <Color x:Key="SurfaceColor">#101B2E</Color>
    <Color x:Key="SurfaceAltColor">#16243A</Color>
    <Color x:Key="ElevatedColor">#1B2B43</Color>
    <Color x:Key="AccentColor">#19C99A</Color>
    <Color x:Key="AccentHoverColor">#36DBAE</Color>
    <Color x:Key="AccentDarkColor">#0B6F5A</Color>
    <Color x:Key="TextColor">#F4F8FF</Color>
    <Color x:Key="MutedColor">#AAB9CF</Color>
    <Color x:Key="SubtleColor">#7789A3</Color>
    <Color x:Key="BorderColor">#2B3C55</Color>
    <Color x:Key="DangerColor">#FF6B78</Color>
    <Color x:Key="WarnColor">#F4B95E</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B1425"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0A1425"/>
</ResourceDictionary>

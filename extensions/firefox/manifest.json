{
  "manifest_version": 3,
  "name": "SDM",
  "version": "1.0.0",
  "description": "SDM 브라우저 연결 — 다운로드 가로채기, 우클릭 전송, 미디어 스니퍼",
  "browser_specific_settings": {
    "gecko": {
      "id": "sdm@sdm.app",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "SDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "cookies",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"]
}
